<%- include('partials/header') %>

  <h1>
    <%= project.title %>
  </h1>

  <p>
    <a href="/assign-categories/<%= project.project_id %>">
      Edit Categories
    </a>
  </p>

  <p><strong>Description:</strong>
    <%= project.description %>
  </p>

  <p><strong>Date:</strong>
    <%= project.date %>
  </p>

  <p><strong>Location:</strong>
    <%= project.location %>
  </p>

  <p>
    <strong>Partner Organization:</strong>
    <a href="/organization/<%= project.organization_id %>">
      <%= project.organization_name %>
    </a>
  </p>

  <p>
    <a href="/edit-project/<%= project.project_id %>">Edit Proje<% if (user && user.role_name==='admin' ) { %>
        <a href="/edit-project/<%= project.project_id %>">
          Edit Project
        </a>
        <% } %>ct</a>
  </p>

  <p>
    <a href="/projects">Back to Service Projects</a>
  </p>

  <h2>Categories</h2>

  <ul>
    <% categories.forEach(category=> { %>
      <li>
        <a href="/category/<%= category.category_id %>">
          <%= category.name %>
        </a>
      </li>
      <% }) %>
  </ul>

  <%- include('partials/footer') %>