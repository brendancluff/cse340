<%- include('partials/header') %>

<main>
  <h1><%= project.title %></h1>

  <p><strong>Description:</strong> <%= project.description %></p>

  <p><strong>Date:</strong> <%= project.project_date || project.date %></p>

  <p><strong>Location:</strong> <%= project.location %></p>

  <p>
    <strong>Partner Organization:</strong>
    <a href="/organization/<%= project.organization_id %>">
      <%= project.organization_name %>
    </a>
  </p>

  <% if (user && user.role_name === 'admin') { %>
    <p>
      <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
    </p>

    <p>
      <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
    </p>
  <% } %>

  <% if (typeof accountData !== 'undefined' && accountData) { %>
    <section class="volunteer-section">
      <% if (isVolunteering) { %>
        <p><strong>You are volunteering for this project.</strong></p>

        <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
          <button type="submit">Remove Me as Volunteer</button>
        </form>
      <% } else { %>
        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
          <button type="submit">Volunteer for this Project</button>
        </form>
      <% } %>
    </section>
  <% } %>

  <h2>Categories</h2>

  <% if (categories && categories.length > 0) { %>
    <ul>
      <% categories.forEach(category => { %>
        <li>
          <a href="/category/<%= category.category_id %>">
            <%= category.name %>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No categories assigned.</p>
  <% } %>

  <p>
    <a href="/projects">Back to Service Projects</a>
  </p>
</main>

<%- include('partials/footer') %>