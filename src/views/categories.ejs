<%- include('partials/header') %>

<h1><%= title %></h1>

<% if (isLoggedIn && role_name === 'admin') { %>
  <p>
    <a href="/new-category">Add New Category</a>
  </p>
<% } %>

<ul>
  <% categories.forEach(category => { %>
    <li>
      <a href="/category/<%= category.category_id %>">
        <%= category.name %>
      </a>

      <% if (isLoggedIn && role_name === 'admin') { %>
        | <a href="/edit-category/<%= category.category_id %>">Edit</a>
      <% } %>
    </li>
  <% }) %>
</ul>

<%- include('partials/footer') %>