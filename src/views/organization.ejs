<%- include('partials/header') %>

<h1><%= organizationDetails.name %></h1>

<p>
  <a href="/edit-organization/<%= organizationDetails.organization_id %>">
    Edit Organization
  </a>
</p>

<% if (organizationDetails.logo_filename) { %>
  <img
    src="/images/<%= organizationDetails.logo_filename %>"
    alt="<%= organizationDetails.name %> logo"
    style="max-width: 200px;"
  >
<% } %>

<p><strong>Description:</strong> <%= organizationDetails.description %></p>

<p><strong>Contact Email:</strong> <%= organizationDetails.contact_email %></p>

<h2>Service Projects</h2>

<% if (projects.length > 0) { %>
  <ul>
    <% projects.forEach(project => { %>
      <li>
        <a href="/project/<%= project.project_id %>">
          <%= project.title %>
        </a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No projects found for this organization.</p>
<% } %>

<p>
  <a href="/organizations">Back to Organizations</a>
</p>

<%- include('partials/footer') %>