<%- include('partials/header') %>

<h1>Edit Organization</h1>

<form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST">
  <label for="name">Organization Name</label>
  <input
    type="text"
    id="name"
    name="name"
    value="<%= organizationDetails.name %>"
    required
    maxlength="150"
  >

  <label for="description">Description</label>
  <textarea
    id="description"
    name="description"
    required
    maxlength="500"
  ><%= organizationDetails.description %></textarea>

  <label for="contactEmail">Contact Email</label>
  <input
    type="email"
    id="contactEmail"
    name="contactEmail"
    value="<%= organizationDetails.contact_email %>"
    required
  >

  <button type="submit">Update Organization</button>
</form>

<p>
  <a href="/organization/<%= organizationDetails.organization_id %>">Cancel</a>
</p>

<%- include('partials/footer') %>