<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <% if (user && user.role_name === 'admin') { %>
    <p>
      <a href="/new-project">Add a New Project</a>
    </p>
  <% } %>

  <ul>
    <% projects.forEach(project => { %>
      <li>
        <h2>
          <a href="/project/<%= project.project_id %>">
            <%= project.title %>
          </a>
        </h2>

        <p>
          Organization:
          <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
          </a>
        </p>

        <% if (user && user.role_name === 'admin') { %>
          <p>
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
          </p>
        <% } %>
      </li>
    <% }) %>
  </ul>
</main>

<%- include('partials/footer') %>