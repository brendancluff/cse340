<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <h2>Dashboard</h2>

  <p>Name: <%= user.name %></p>
  <p>Username: <%= user.email %></p>

  <% if (user.role_name === 'admin') { %>
    <p>
      <a href="/users">View Registered Users</a>
    </p>
  <% } %>

  <section>
    <h2>My Volunteer Projects</h2>

    <% if (!volunteerProjects || volunteerProjects.length === 0) { %>
      <p>You have not volunteered for any projects yet.</p>
    <% } else { %>
      <ul>
        <% volunteerProjects.forEach(project => { %>
          <li>
            <a href="/project/<%= project.project_id %>">
              <%= project.title %>
            </a>

            <% if (project.organization_name) { %>
              - <%= project.organization_name %>
            <% } %>

            <% if (project.project_date) { %>
              - <%= new Date(project.project_date).toLocaleDateString() %>
            <% } %>

            <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
              <button type="submit">Remove</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>